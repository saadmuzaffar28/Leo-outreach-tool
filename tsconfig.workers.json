{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist/workers",
    "rootDir": ".",
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "isolatedModules": true
  },
  "include": [
    "scripts/worker.ts",
    "scripts/warmup-worker.ts",
    "scripts/verification-worker.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "tests"]
}