generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  name              String?
  passwordHash      String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  campaigns         Campaign[]
  contacts          Contact[]
  dailyCounters     DailySendCounter[]
  templates         EmailTemplate[]
  googleAccounts    GoogleAccount[]
  groups            Group[]
  leads             Lead[]
  messages          Message[]
  microsoftAccounts MicrosoftAccount[]
  replies           Reply[]
  sendSettings      SendSettings?
  smsCampaigns      SmsCampaign[]
  smsTemplates      SmsTemplate[]
  smtpAccounts      SmtpAccount[]
  suppressions      Suppression[]
  warmupDailyUsage  WarmupDailyUsage[]
  warmupEvents      WarmupEvent[]
  warmupJobs        WarmupJob[]
  warmupMailboxes   WarmupMailboxSettings[]
}

model GoogleAccount {
  id                    String     @id @default(cuid())
  userId                String
  googleEmail           String     @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                String[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  signature             String?
  consecutiveQuotaHits  Int        @default(0)
  lastQuotaAt           DateTime?
  quotaMessage          String?
  quotaPausedUntil      DateTime?
  signatureOverride     String?
  status                String     @default("connected")
  statusMessage         String?
  campaigns             Campaign[]
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model MicrosoftAccount {
  id                    String     @id @default(cuid())
  userId                String
  microsoftEmail        String     @unique
  displayName           String?
  providerAccountId     String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                String[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  connectMode           String     @default("normal")
  sendFromEmail         String?
  sharePermission       String?
  quotaPausedUntil      DateTime?
  quotaMessage          String?
  consecutiveQuotaHits  Int        @default(0)
  lastQuotaAt           DateTime?
  signatureOverride     String?
  campaigns             Campaign[]
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SmtpAccount {
  id                    String                 @id @default(cuid())
  userId                String
  email                 String
  host                  String
  port                  Int                    @default(465)
  security              String                 @default("ssl")
  usernameEncrypted     String
  passwordEncrypted     String
  status                String                 @default("disconnected")
  lastTestedAt          DateTime?
  lastTestError         String?
  lastSuccessFrom       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  imapHost              String?
  imapLastTestError     String?
  imapLastTestedAt      DateTime?
  imapPasswordEncrypted String?
  imapPort              Int                    @default(993)
  imapSecurity          String                 @default("ssl")
  imapStatus            String                 @default("unconfigured")
  imapUsernameEncrypted String?
  campaigns             Campaign[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedWarmupJobs    WarmupJob[]            @relation("WarmupReceiver")
  sentWarmupJobs        WarmupJob[]            @relation("WarmupSender")
  warmupSettings        WarmupMailboxSettings?

  @@index([userId])
}

model SendSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  dailySendLimit            Int      @default(100)
  messagesPerMinute         Int      @default(3)
  minDelaySeconds           Int      @default(20)
  maxDelaySeconds           Int      @default(60)
  maxRetryAttempts          Int      @default(5)
  baseRetryDelaySeconds     Int      @default(60)
  maxRetryDelaySeconds      Int      @default(3600)
  sendMode                  String   @default("live")
  updatedAt                 DateTime @updatedAt
  warmupDailyIncrease       Int      @default(1)
  warmupEnabled             Boolean  @default(false)
  warmupMaxDelaySeconds     Int      @default(120)
  warmupMaximumDailyVolume  Int      @default(15)
  warmupMinDelaySeconds     Int      @default(60)
  warmupStartingDailyVolume Int      @default(5)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailySendCounter {
  id              String   @id @default(cuid())
  userId          String
  date            String
  messagesSent    Int      @default(0)
  messagesFailed  Int      @default(0)
  messagesSkipped Int      @default(0)
  updatedAt       DateTime @updatedAt
  accountId       String
  provider        String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, accountId, date])
  @@index([userId, date])
}

model Lead {
  id           String              @id @default(cuid())
  userId       String
  firstName    String
  lastName     String?
  email        String
  practiceName String?
  phone        String?
  customField1 String?
  customField2 String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  recipients   CampaignRecipient[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadGroups   LeadGroup[]

  @@unique([userId, email])
  @@index([userId])
}

model Group {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaigns   Campaign[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadGroups  LeadGroup[]

  @@unique([userId, name])
  @@index([userId])
}

model LeadGroup {
  id        String   @id @default(cuid())
  groupId   String
  leadId    String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([groupId, leadId])
  @@index([groupId])
  @@index([leadId])
}

model EmailTemplate {
  id                String     @id @default(cuid())
  userId            String
  name              String
  subject           String
  body              String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  signatureOverride String?
  useSignature      Boolean    @default(true)
  isActive          Boolean    @default(true)
  campaigns         Campaign[]
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Campaign {
  id                 String              @id @default(cuid())
  userId             String
  name               String
  status             String              @default("draft")
  templateId         String?
  googleAccountId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  startedAt          DateTime?
  stoppedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  pausedReason       String?
  templateSnapshot   Json?
  microsoftAccountId String?
  smtpAccountId      String?
  recipientGroupId   String?
  senderName         String?
  googleAccount      GoogleAccount?      @relation(fields: [googleAccountId], references: [id])
  microsoftAccount   MicrosoftAccount?   @relation(fields: [microsoftAccountId], references: [id])
  recipientGroup     Group?              @relation(fields: [recipientGroupId], references: [id])
  smtpAccount        SmtpAccount?        @relation(fields: [smtpAccountId], references: [id])
  template           EmailTemplate?      @relation(fields: [templateId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients         CampaignRecipient[]

  @@index([userId])
  @@index([status])
}

model CampaignRecipient {
  id              String    @id @default(cuid())
  campaignId      String
  leadId          String?
  recipient       String
  subject         String?
  status          String    @default("pending")
  attempts        Int       @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  sentAt          DateTime?
  googleMessageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isTest          Boolean   @default(false)
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead            Lead?     @relation(fields: [leadId], references: [id])

  @@unique([campaignId, recipient])
  @@index([campaignId])
  @@index([status])
  @@index([recipient])
  @@index([createdAt, id])
}

model Suppression {
  id        String   @id @default(cuid())
  userId    String
  email     String
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model SmsCampaign {
  id          String    @id @default(cuid())
  userId      String
  name        String
  message     String
  status      String    @default("draft")
  source      String    @default("8x8")
  x8BatchId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime?
  completedAt DateTime?
  messages    Message[]
  replies     Reply[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Contact {
  id          String    @id @default(cuid())
  userId      String
  name        String
  phoneNumber String
  status      String    @default("active")
  optOut      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  replies     Reply[]

  @@unique([userId, phoneNumber])
  @@index([userId])
}

model Message {
  id            String         @id @default(cuid())
  userId        String
  campaignId    String?
  contactId     String?
  x8MessageId   String?
  phoneNumber   String
  message       String
  direction     String         @default("outbound")
  status        String         @default("queued")
  source        String?
  lastError     String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaign      SmsCampaign?   @relation(fields: [campaignId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies       Reply[]
  webhookEvents WebhookEvent[]

  @@index([userId])
  @@index([campaignId])
  @@index([x8MessageId])
  @@index([phoneNumber])
  @@index([createdAt])
}

model Reply {
  id          String       @id @default(cuid())
  userId      String
  messageId   String?
  campaignId  String?
  contactId   String?
  phoneNumber String
  message     String
  receivedAt  DateTime     @default(now())
  campaign    SmsCampaign? @relation(fields: [campaignId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  thread      Message?     @relation(fields: [messageId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumber])
  @@index([receivedAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String
  x8MessageId String?
  payload     Json
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id])

  @@index([eventType])
  @@index([x8MessageId])
  @@index([processed])
}

model SmsTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-mailbox warm-up configuration. One row per SMTP mailbox that the
/// operator has enrolled. Created from the global SendSettings defaults, then
/// free to diverge so a global default change never retunes a live ramp.
model WarmupMailboxSettings {
  id                        String             @id @default(cuid())
  userId                    String
  smtpAccountId             String             @unique
  enabled                   Boolean            @default(false)
  /// Day-1 volume, and the step size, and the hard cap for the ramp.
  startingDailyVolume       Int                @default(5)
  maximumDailyVolume        Int                @default(15)
  dailyIncrease             Int                @default(1)
  /// Spacing between warm-up sends, to avoid bursts. Seconds.
  minimumDelaySeconds       Int                @default(60)
  maximumDelaySeconds       Int                @default(120)
  /// Local-time HH:mm window during which warm-up sends are allowed.
  warmupWindowStart         String             @default("09:00")
  warmupWindowEnd           String             @default("17:00")
  /// Pause the mailbox after maxConsecutiveFailures consecutive failures.
  pauseOnError              Boolean            @default(true)
  maxConsecutiveFailures    Int                @default(3)
  /// running | paused | paused_error | completed
  status                    String             @default("paused")
  /// Set when status is paused_error. Requires a manual resume after the fix.
  statusMessage             String?
  /// Consecutive days with at least one confirmed delivery. Resets on any
  /// failed day. Display only -- never used to raise campaign volume.
  consecutiveSuccessfulDays Int                @default(0)
  consecutiveFailures       Int                @default(0)
  /// Day number of the ramp. 1 = the first day warm-up has actually run.
  currentDay                Int                @default(0)
  /// Last day a warm-up send actually happened, YYYY-MM-DD (UTC).
  lastActiveDate            String?
  lastSendAt                DateTime?
  /// When the operator may next start/enable this mailbox.
  startedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  usage                     WarmupDailyUsage[]
  jobs                      WarmupJob[]
  smtpAccount               SmtpAccount        @relation(fields: [smtpAccountId], references: [id], onDelete: Cascade)
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

/// One warm-up message attempt. Separate from CampaignRecipient on purpose:
/// warm-up never touches the campaign queue and campaign sends never touch this.
model WarmupJob {
  id                    String                @id @default(cuid())
  userId                String
  mailboxId             String
  /// The mailbox that SENT this message.
  senderSmtpAccountId   String
  /// The mailbox that should RECEIVE it (chosen by rotation). Always an
  /// enrolled pool mailbox -- never an external prospect.
  receiverSmtpAccountId String
  /// Our own RFC 5322 Message-ID, also written to a X-Warmup-Job header so the
  /// IMAP poller can match an incoming message back to this exact job.
  messageId             String                @unique
  subject               String
  /// queued | sending | sent | delivered | failed | unconfirmed | cancelled
  status                String                @default("queued")
  scheduledFor          DateTime
  claimedAt             DateTime?
  /// Lease expiry: a crashed worker's job is reclaimable after this.
  leaseExpiresAt        DateTime?
  attempts              Int                   @default(0)
  sentAt                DateTime?
  /// Set ONLY after IMAP actually found the message. An SMTP acceptance alone
  /// never sets this.
  deliveredAt           DateTime?
  /// Milliseconds between SMTP accept and IMAP observation.
  deliveryLatencyMs     Int?
  /// Mailbox-observed identifier, recorded for auditability only.
  receiverMessageId     String?
  lastError             String?
  failureKind           String?
  permanentError        Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  events                WarmupEvent[]
  mailbox               WarmupMailboxSettings @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  receiverSmtpAccount   SmtpAccount           @relation("WarmupReceiver", fields: [receiverSmtpAccountId], references: [id], onDelete: Cascade)
  senderSmtpAccount     SmtpAccount           @relation("WarmupSender", fields: [senderSmtpAccountId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([mailboxId, status])
  @@index([userId, createdAt])
}

/// Append-only audit trail of everything that happened to a warm-up job:
/// scheduled, claimed, sent, SMTP-failed, IMAP-confirmed, IMAP-failed.
model WarmupEvent {
  id        String     @id @default(cuid())
  jobId     String?
  mailboxId String
  userId    String
  /// scheduled | claimed | sent | delivered | smtp_failed | imap_failed
  /// | imap_unconfirmed | paused | resumed | reset | skipped
  type      String
  message   String?
  /// Extra structured detail. Never contains credentials or message bodies.
  meta      Json?
  createdAt DateTime   @default(now())
  job       WarmupJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User      User       @relation(fields: [userId], references: [id])

  @@index([mailboxId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
}

/// Per-mailbox, per-day warm-up bookkeeping (ramp day, warm-up send count,
/// target).
///
/// IMPORTANT: this table is NOT the sending ceiling. The absolute per-mailbox
/// daily ceiling is the existing DailySendCounter, which counts campaign AND
/// warm-up sends against one shared budget. If this table also tracked the
/// ceiling, the two could disagree and the shared limit would be fiction.
/// warmupSent here is a per-day breakdown for charts only.
model WarmupDailyUsage {
  id           String                @id @default(cuid())
  mailboxId    String
  userId       String
  date         String
  warmupSent   Int                   @default(0)
  warmupFailed Int                   @default(0)
  delivered    Int                   @default(0)
  /// The ramp target that applied on this day (starting + increase * (day-1)).
  target       Int                   @default(0)
  /// Ramps to a new day only after a day with activity, so a paused mailbox
  /// does not jump 3 days forward on resume.
  rampDay      Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  mailbox      WarmupMailboxSettings @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  User         User                  @relation(fields: [userId], references: [id])

  @@unique([mailboxId, date])
  @@index([userId, date])
}
