# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# embedded postgres data dir (local database — never commit)
/.pgdata/

# runtime logs + pid files
*.log
*.log.*
db.log*
*.pid

# ownership marker written by the (now removed) leo-db supervisor
# (scripts/dev-db.mjs, deleted 2026-10-06). Kept ignored because a stale copy
# may still exist on disk from before the move to the LeoPostgres Windows
# service. Machine-local state, never part of the repository.
/.leo-db-owner.json

# typescript
*.tsbuildinfo

# prisma
# generated client is usually committed, but keep db files out
/prisma/*.db
# ---------------------------------------------------------------------------
# Secrets that the rules above did not catch. Added at the first git commit.
# These were all present on disk and would otherwise have been committed with
# LIVE credentials, which cannot be undone by amending the commit.
# ---------------------------------------------------------------------------

# Every .env variant EXCEPT the template. The existing rule only covered
# .env and .env*.local, so five dated backups of the real file
# (.env.bak-*, .env.backup-*) were about to be tracked.
/.env.*
!/.env.example

# Admin login and Cloudflare tunnel token, both local-only.
/.admin-credentials.txt
/TUNNEL-URL.txt

# Local snapshots and data exports: OAuth status payloads and a contacts
# export, which can carry tokens and personal data.
/.snapshots/
/backups/

# Zero-byte artefacts from a shell redirect that was missing its target file.
/newestGoogle.updatedAt.getTime())/
/newestMicrosoft.updatedAt.getTime())/

# ---------------------------------------------------------------------------
# Added for the GitHub push.
# ---------------------------------------------------------------------------

# Compiled worker bundle. Generated from src/ by the workers tsconfig, so
# committing it would only add a second copy that drifts out of date.
/dist/

# Runtime log directory. The *.log rules already caught the individual files,
# but observe.jsonl (output from scripts/lib/observe.mjs) slipped through
# because *.log does not match .jsonl. Ignoring the whole directory closes
# that class of leak instead of one filename.
/logs/