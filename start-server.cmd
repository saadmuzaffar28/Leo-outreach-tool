@echo off`r`nsetlocal`r`ntitle Star Billing Outreach Launcher`r`n`r`nset "DIR=C:\Users\PC\Documents\star-billing-outreach-main\star-billing-outreach-main`r`ncd /d %DIR%`r`n`r`necho Starting Star Billing Outreach services...`r`necho.`r`n`r`nrem ---- Database (embedded Postgres on port 5438) ----`r`nnetstat -ano | findstr /r /c::5438 .*LISTENING >nul 2>&1`r`nif 0==0 (`r`n echo [ok] Database is already running.`r`) else (`r`n echo [..] Starting database...`r`n start Star Billing - Database cmd /k cd /d "%DIR%" && node scripts\dev-db.mjs`r`)`r`n`r`nrem ---- App (Next.js on port 3002) ----`r`nnetstat -ano | findstr /r /c::3002 .*LISTENING >nul 2>&1`r`nif 0==0 (`r`n echo [ok] App is already running at http://localhost:3002`r`) else (`r`n echo [..] Starting app...`r`n start Star Billing - App cmd /k cd /d "%DIR%" && npm run dev`r`)`r`n`r`nrem ---- Send worker ----`r`npowershell -NoProfile -ExecutionPolicy Bypass -Command if (Get-CimInstance Win32_Process | Where-Object {$_.Name -eq 'node.exe' -and $_.CommandLine -match 'worker'}) { exit 0 } else { exit 1 } >nul 2>&1`r`nif 0==0 (`r`n echo [ok] Send worker is already running.`r`) else (`r`n echo [..] Starting send worker...`r`n start Star Billing - Worker cmd /k cd /d "%DIR%" && npm run worker`r`)`r`n`r`necho.`r`necho Services launched. Open http://localhost:3002`r`nendlocal`r`n